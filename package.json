{
  "name": "clocked",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "deploy": "bash scripts/deploy.sh",
    "fake-plaid": "node scripts/fake-plaid.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "idb": "^8.0.3",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
